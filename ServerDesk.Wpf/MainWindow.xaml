<Window x:Class="ServerDesk.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ServerDesk" Width="420" Height="300">
    <DockPanel Margin="12">
        <TextBlock x:Name="Status"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   Text="Wczytywanie urządzeń…" />
        <ListBox x:Name="DeviceList" DisplayMemberPath="Name" />
    </DockPanel>
</Window>